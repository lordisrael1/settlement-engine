# Configuration arrives as environment variables, never baked into the image.
# docker-compose.yml sets these for you; copy to .env only for running outside Docker.

DATABASE_URL=postgres://recon:recon@localhost:5432/recon

# Who may call the management endpoints, and what each of them may do.
#
# A comma-separated list of "principal:secret:grant|grant". Every key belongs to a named
# principal, because the evidence endpoints record who read what and one shared key makes
# that record a list of the word "api" (ADR-0066). Two grants exist:
#
#   evidence.raw      may read the bytes of a stored document
#   evidence.export   may take a copy out of the system
#
# The service refuses to start without this, and refuses to start if the old RECON_API_KEY
# is still set.
RECON_API_KEYS=amaka@example.com:local-dev-key-0123456789,auditor@example.com:local-dev-audit-0123456789:evidence.raw|evidence.export

# The root key evidence is encrypted under, as "<key-id>:<base64 of 32 bytes>".
#
#   echo "k1:$(openssl rand -base64 32)"
#
# Evidence is encrypted per record before it is stored and there is deliberately no
# unencrypted path (ADR-0063), so the service refuses to start without one. A deployment on
# a KMS replaces the key ring in apps/*/vault.ts and leaves everything else alone.
RECON_EVIDENCE_KEY=k1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# Keys that no longer seal new records but must still unwrap old ones. A retired key stays
# here for as long as anything sealed under it is still within its retention: dropping it
# early does not delete that evidence, it makes it unreadable.
# RECON_EVIDENCE_KEYS_RETIRED=k0:<base64>

# How long each version of a document is kept, in days. The defaults are a starting position
# and not a legal opinion — the redacted horizon in particular is a question for counsel
# against CBN and FIRS record-keeping obligations (ADR-0065).
# RECON_RETENTION_ORIGINAL_DAYS=30      # the dispute window, after which payloads are reduced
# RECON_RETENTION_REDACTED_DAYS=2192    # six years: the financial record horizon
# RECON_RETENTION_INBOX_DAYS=30         # stragglers the drain never worked

# How long an export link lives. Minutes, not days: a link valid for a week gets forwarded.
# RECON_EXPORT_TTL_MS=900000

# What each provider signs its deliveries with. Webhooks authenticate by signature and by
# nothing else. One variable per source; a source with no secret here answers 503 and
# stores nothing.
RECON_WEBHOOK_SECRET_PAYSTACK=sk_test_demo_secret
RECON_WEBHOOK_SECRET_FLUTTERWAVE=flw_test_demo_secret_hash

# Whose books these are, and which of our own accounts a statement upload is about when the
# request does not say. Fee contracts are negotiated per merchant.
RECON_MERCHANT=demo-merchant
RECON_BANK_ACCOUNT=gtb-3011
RECON_BANK=gtbank

# The inbox worker. The interval is how long a delivery may sit accepted but not yet booked;
# the batch is how many one pass works. Both are visible in /health as the pending depth.
# RECON_DRAIN_INTERVAL_MS=500
# RECON_DRAIN_BATCH=100
# RECON_DRAIN_MAX_ATTEMPTS=8

# PORT=8080
# LOG_LEVEL=info
