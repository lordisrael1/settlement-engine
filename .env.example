# Configuration arrives as environment, never baked into the image.
# docker-compose.yml sets these for you; copy to .env only for running outside Docker.

DATABASE_URL=postgres://recon:recon@localhost:5432/recon

# The management credential. Every endpoint except /health and the webhook rail requires it
# in an X-API-Key header. The service refuses to start without one — a service that quietly
# serves balances and books resolutions unauthenticated is a worse failure than one that
# does not come up (D-052).
RECON_API_KEY=local-dev-key-0123456789

# What each provider signs its deliveries with. Webhooks authenticate by signature and by
# nothing else: a PSP holds no key of ours. One variable per source, so adding a source is
# an adapter and an environment variable, never a branch on a name (Law 7). A source with no
# secret here answers 503 and stores nothing.
RECON_WEBHOOK_SECRET_PAYSTACK=sk_test_demo_secret
RECON_WEBHOOK_SECRET_FLUTTERWAVE=flw_test_demo_secret_hash

# Whose books these are, and which of our own accounts a statement upload is about when the
# request does not say. Fee contracts are negotiated per merchant, so this travels with
# every run rather than being assumed.
RECON_MERCHANT=demo-merchant
RECON_BANK_ACCOUNT=gtb-3011
RECON_BANK=gtbank

# The inbox worker. The interval is how long a delivery may sit accepted-but-unbooked; the
# batch is how many one pass works. Both are visible in /health as the pending depth.
# RECON_DRAIN_INTERVAL_MS=500
# RECON_DRAIN_BATCH=100
# RECON_DRAIN_MAX_ATTEMPTS=8

# PORT=8080
# LOG_LEVEL=info
